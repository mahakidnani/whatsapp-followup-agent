            "parameters": {
                "promptType": "define",
                "text": "=Task: {{ $('Pick Active Task').first().json.TaskDescription }} with {{ $('Pick Active Task').first().json.ContactName }}.\nNotes so far: {{ $('Pick Active Task').first().json.Notes || 'none' }}\n\nThey just replied on WhatsApp: {{ $('WhatsApp Message Received').item.json.messages[0].text.body }}",
                "hasOutputParser": true,
                "options": {
                    "systemMessage": "You are helping track a real-world follow-up task for the task owner. Decide what happens next based on the contact's reply. If they gave a NEW phone number to contact, such as an engineer or colleague, set nextAction.type to 'message_new_contact' with that phone in international format digits only, and a natural message to send them to continue the task. If the task seems fully done, set status to 'Done'. Otherwise status stays 'In Progress' and nextAction.type is 'none', with phone and message null. Also write replyToContact: a short natural WhatsApp reply to send back to them, can be empty string if nothing needs to be said. Also write reportToOwner: a short WhatsApp message summarizing what happened, to send to the task owner. Also write notes: an updated summary of the task status to save."
                }
            },
