        {
            "parameters": {
                "promptType": "define",
                "text": "=The owner just sent this message: {{ $('WhatsApp Message Received').item.json.messages[0].text.body }}\n\nCurrent OPEN tasks:\n{{ (() => { const open = $('Get Open Tasks').all().filter(i => i.json.Status !== 'Done'); return open.length ? open.map(i => 'row ' + i.json.row_number + ': ' + i.json.ContactName + ' (' + i.json.ContactPhone + ') - task: ' + i.json.TaskDescription + ' - notes: ' + (i.json.Notes || 'none')).join('\\n') : 'No open tasks right now.'; })() }}",
                "hasOutputParser": true,
                "options": {
                    "systemMessage": "You are a task router for a personal WhatsApp follow-up assistant. Decide: is the owner's message a brand-new task, or does it update or continue an existing open task? If it matches an existing task closely, use action 'update' and set taskId to that task's row number. If it is clearly new, use action 'new', taskId null, and contactPhone must be a phone number the owner mentioned, digits only, international format like 919876543210, or null if none was given. Write messageToSend: the actual WhatsApp message to send the contact, written naturally like a person texting them. Write taskDescription summarizing the instruction."
                }
            },
